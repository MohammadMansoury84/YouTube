<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="700.0" prefWidth="700.0" style="-fx-background-color: BLACK;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo3.View.EditInformationUserController">
   <children>
      <Button layoutX="608.0" layoutY="642.0" mnemonicParsing="false" onAction="#back" text="back" />
      <ImageView fitHeight="78.0" fitWidth="125.0" layoutX="294.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../images/102352.png" />
         </image>
      </ImageView>
      <Button layoutX="307.0" layoutY="573.0" mnemonicParsing="false" onAction="#confirmation" text="Confirmation" />
      <TextField fx:id="nameOrPassword" layoutX="330.0" layoutY="324.0" promptText="nameOrPassword...." />
      <Label layoutX="223.0" layoutY="273.0" text="edit Type :" textFill="#ff5959">
         <font>
            <Font name="Comic Sans MS Bold" size="15.0" />
         </font>
      </Label>
      <RadioButton fx:id="name" layoutX="319.0" layoutY="275.0" mnemonicParsing="false" onAction="#name" text="Name" textFill="WHITE">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
         <toggleGroup>
            <ToggleGroup fx:id="bb" />
         </toggleGroup>
      </RadioButton>
      <RadioButton fx:id="password" layoutX="393.0" layoutY="275.0" mnemonicParsing="false" onAction="#password" text="Password" textFill="WHITE" toggleGroup="$bb">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </RadioButton>
      <Label layoutX="170.0" layoutY="326.0" text="name Or Password :" textFill="#ff6060">
         <font>
            <Font name="Comic Sans MS Bold" size="14.0" />
         </font>
      </Label>
      <Label layoutX="265.0" layoutY="115.0" text="Edit Information" textFill="WHITE">
         <font>
            <Font name="System Bold Italic" size="22.0" />
         </font>
      </Label>
   </children>
</AnchorPane>

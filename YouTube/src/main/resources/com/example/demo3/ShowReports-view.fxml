      <TextField fx:id="reportId" layoutX="535.0" layoutY="475.0" prefHeight="10.0" prefWidth="57.0" />
      <Button layoutX="507.0" layoutY="511.0" mnemonicParsing="false" onAction="#manage" prefHeight="26.0" prefWidth="66.0" style="-fx-background-color: red;" text="manage">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>

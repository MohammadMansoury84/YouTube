      <Text fill="RED" layoutX="176.0" layoutY="103.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Reports">
         <font>
            <Font name="System Bold Italic" size="20.0" />
         </font>
      </Text>
      <ListView fx:id="reportList" layoutX="25.0" layoutY="120.0" prefHeight="526.0" prefWidth="347.0" />
      <ImageView fitHeight="55.0" fitWidth="200.0" layoutX="310.0" layoutY="8.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../images/102352.png" />
         </image>
      </ImageView>
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#4e4e4e" height="200.0" layoutX="401.0" layoutY="109.0" stroke="BLACK" strokeType="INSIDE" width="274.0" />
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#4e4e4e" height="45.0" layoutX="589.0" layoutY="315.0" stroke="BLACK" strokeType="INSIDE" width="85.0" />

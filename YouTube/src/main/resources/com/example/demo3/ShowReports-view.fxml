      </Button>
      <Button layoutX="634.0" layoutY="324.0" mnemonicParsing="false" onAction="#pauseVideo" prefHeight="27.0" prefWidth="35.0" style="-fx-background-color: red;" text="⏸" textFill="WHITE">

      <Label layoutX="405.0" layoutY="331.0" text="content Id :" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <StackPane layoutX="411.0" layoutY="122.0" prefHeight="174.0" prefWidth="254.0">
         <children>
            <MediaView fx:id="mediaView" fitHeight="184.0" fitWidth="251.0" StackPane.alignment="CENTER" />
         </children>
      </StackPane>
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#4b4b4b" height="129.0" layoutX="401.0" layoutY="418.0" stroke="BLACK" strokeType="INSIDE" width="280.0" />
      <Label layoutX="483.0" layoutY="418.0" text="Manage reports" textFill="WHITE">
